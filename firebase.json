{
  "auth": {
    "authorizedDomains": [
      "localhost",
      "127.0.0.1",
      "bhurtelmahesh.github.io",
      "chartlens101.web.app",
      "chartlens101.firebaseapp.com"
    ],
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "ChartLens",
        "supportEmail": "bhurtelace@gmail.com"
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "README.md",
      "**/.*",
      "**/node_modules/**",
      ".agents/**",
      "functions/**",
      "firestore.rules",
      "firestore.indexes.json",
      "firebase-config.example.js",
      "skills-lock.json"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      }
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          }
        ]
      }
    ]
  }
}
